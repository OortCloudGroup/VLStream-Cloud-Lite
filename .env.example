TZ=Asia/Shanghai
WVP_IMAGE=ghcr.io/oortcloudgroup/vlstream-cloud-lite:1.0.6
MYSQL_IMAGE=mysql:8.0.36
REDIS_IMAGE=redis:7.4.9-alpine
MQTT_IMAGE=emqx/emqx:5.4
ZLM_IMAGE=zlmediakit/zlmediakit:master
ZLM_RELEASE_IMAGE=vlstream-wvp-lite-zlmediakit:1.0.6

WVP_HTTP_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
MQTT_PORT=1883
ZLM_HTTP_PORT=8081
ZLM_HTTPS_PORT=8443
ZLM_WS_PORT=8081
SIP_PORT=8116
RTP_PORT_START=40000
RTP_PORT_END=40300

DB_NAME=ry-wvp
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_USERNAME=wvp
DB_PASSWORD=change-me-db-password
DB_MIGRATION_USERNAME=root
DB_MIGRATION_PASSWORD=change-me-root-password
MYSQL_ROOT_PASSWORD=change-me-root-password
REDIS_PASSWORD=change-me-redis-password
REDIS_HOST=redis.example.internal
VLSTREAM_MQTT_ENABLED=true
VLSTREAM_MQTT_HOST=mqtt.example.internal
VLSTREAM_MQTT_PORT=1883
VLSTREAM_MQTT_USERNAME=
VLSTREAM_MQTT_PASSWORD=
VLSTREAM_WVP_MQTT_CLIENT_ID=wvp-vlstream-backend
TOKEN_SECRET=change-me-token-secret
SIP_PASSWORD=change-me-sip-password
ZLM_SECRET=change-me-zlm-secret
SSL_KEY_STORE_PASSWORD=change-me-keystore-password
ISUP_KEY=change-me-isup-key
EHOME_PUBLIC_HOST=
EHOME_MEDIA_PUBLIC_HOST=
EHOME_MEDIA_HTTP_PORT=8081
EHOME_REGISTRATION_PORT=7660
EHOME_STREAM_PORT=7665

ZLM_HOST=zlmediakit
ZLM_HOOK_IP=wvp-backend
ZLM_PUBLIC_HOST=127.0.0.1
VLSTREAM_VERIFY_TOKEN=http://host.docker.internal:8080/blade-system/user/info
SSO_VERIFY_TOKEN=
VLSTREAM_FIRMWARE_MINIO_ENDPOINT=
VLSTREAM_FIRMWARE_PUBLIC_ENDPOINT=
VLSTREAM_FIRMWARE_MINIO_ACCESS_KEY=
VLSTREAM_FIRMWARE_MINIO_SECRET_KEY=
VLSTREAM_FIRMWARE_MINIO_BUCKET=vls-firmware
VLSTREAM_WVP_PUBLIC_URL=
WVP_AUTH_MODE=LOCAL
DAHUA_ENABLED=false
JAVA_OPTS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8
