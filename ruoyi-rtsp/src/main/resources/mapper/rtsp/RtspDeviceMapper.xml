<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.rtsp.mapper.RtspDeviceMapper">

    <resultMap type="RtspDevice" id="RtspDeviceResult">
        <result property="id"    column="id"    />
        <result property="tenantId" column="tenant_id"/>
        <result property="deptId"    column="dept_id"    />
        <result property="ip"    column="ip"    />
        <result property="name"    column="name"    />
        <result property="userName"    column="user_name"    />
        <result property="password"    column="password"    />
        <result property="channel"    column="channel"    />
        <result property="playType"    column="play_type"    />
        <result property="url"    column="url"    />
        <result property="streamId"    column="stream_id"    />
        <result property="easyNTSUrl"    column="easy_NTS_url"    />
        <result property="firm"    column="firm"    />
        <result property="lat"    column="lat"    />
        <result property="lng"    column="lng"    />
        <result property="addressMap"    column="address_map"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectRtspDeviceVo">
        select r.id,
               r.tenant_id,
               r.dept_id,
               r.ip,
               r.name,
               r.user_name,
               r.password,
               r.channel,
               r.play_type,
               r.url,
               r.stream_id,
               r.easy_NTS_url,
               r.firm,
               r.lat,
               r.lng,
               r.address_map,
               r.create_by,
               r.create_time,
               r.update_by,
               r.update_time,
               r.remark,
               d.dept_name
        from rtsp_device r
                 left join sys_dept d on r.dept_id = d.dept_id
    </sql>

    <select id="selectRtspDeviceList" parameterType="RtspDevice" resultMap="RtspDeviceResult">
        <include refid="selectRtspDeviceVo"/>
        <where>
            and (r.tenant_id = #{params.tenantId}<if test="params.tenantId != null and params.tenantId.equals(params.defaultTenantId)"> or r.tenant_id is null or r.tenant_id = ''</if>)
            <if test="id != null">and r.id = #{id}</if>
            <if test="deptId != null">and (r.dept_id = #{deptId} OR r.dept_id IN ( SELECT t.dept_id FROM sys_dept t WHERE find_in_set(#{deptId}, ancestors) ))</if>
            <if test="ip != null  and ip != ''"> and r.ip = #{ip}</if>
            <if test="name != null  and name != ''"> and r.name like concat('%', #{name}, '%')</if>
            <if test="firm != null  and firm != ''"> and r.firm = #{firm}</if>
            <include refid="classificationFilter"/>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>

        order by r.create_time desc
    </select>

    <select id="selectRtspDeviceById" parameterType="Long" resultMap="RtspDeviceResult">
        <include refid="selectRtspDeviceVo"/>
        where id = #{id}
    </select>

    <select id="selectRtspDeviceListMap" parameterType="RtspDevice" resultMap="RtspDeviceResult">
        <include refid="selectRtspDeviceVo"/>
        <where>
            and (r.tenant_id = #{params.tenantId}<if test="params.tenantId != null and params.tenantId.equals(params.defaultTenantId)"> or r.tenant_id is null or r.tenant_id = ''</if>)
            <if test="id != null">and r.id = #{id}</if>
            <if test="deptId != null">and (r.dept_id = #{deptId} OR r.dept_id IN ( SELECT t.dept_id FROM sys_dept t WHERE find_in_set(#{deptId}, ancestors) ))</if>
            <if test="ip != null  and ip != ''"> and r.ip = #{ip}</if>
            <if test="name != null  and name != ''"> and r.name like concat('%', #{name}, '%')</if>
            <if test="firm != null  and firm != ''"> and r.firm = #{firm}</if>
            and lat IS NOT NULL AND lng IS NOT NULL

            <include refid="classificationFilter"/>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>

        order by r.create_time desc
    </select>

    <insert id="insertRtspDevice" parameterType="RtspDevice" useGeneratedKeys="true" keyProperty="id">
        insert into rtsp_device
        <trim prefix="(" suffix=")" suffixOverrides=",">
            tenant_id,
            <if test="deptId != null">dept_id,</if>
            <if test="ip != null and ip != ''">ip,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="password != null and password != ''">password,</if>
            <if test="channel != null and channel != ''">channel,</if>
            <if test="playType != null">play_type,</if>
            <if test="url != null">url,</if>
            <if test="streamId != null">stream_id,</if>
            <if test="easyNTSUrl != null">easy_NTS_url,</if>
            <if test="firm != null">firm,</if>
            <if test="lat != null">lat,</if>
            <if test="lng != null">lng,</if>
            <if test="addressMap != null">address_map,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            #{tenantId},
            <if test="deptId != null">#{deptId},</if>
            <if test="ip != null and ip != ''">#{ip},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="password != null and password != ''">#{password},</if>
            <if test="channel != null and channel != ''">#{channel},</if>
            <if test="playType != null">#{playType},</if>
            <if test="url != null">#{url},</if>
            <if test="streamId != null">#{streamId},</if>
            <if test="easyNTSUrl != null">#{easyNTSUrl},</if>
            <if test="firm != null">#{firm},</if>
            <if test="lat != null">#{lat},</if>
            <if test="lng != null">#{lng},</if>
            <if test="addressMap != null">#{addressMap},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateRtspDevice" parameterType="RtspDevice">
        update rtsp_device
        <trim prefix="SET" suffixOverrides=",">
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="ip != null and ip != ''">ip = #{ip},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="password != null and password != ''">password = #{password},</if>
            <if test="channel != null and channel != ''">channel = #{channel},</if>
            <if test="playType != null">play_type = #{playType},</if>
            <if test="url != null">url = #{url},</if>
            <if test="streamId != null">stream_id = #{streamId},</if>
            <if test="easyNTSUrl != null">easy_NTS_url = #{easyNTSUrl},</if>
            <if test="firm != null">firm = #{firm},</if>
            <if test="lat != null">lat = #{lat},</if>
            <if test="lng != null">lng = #{lng},</if>
            <if test="addressMap != null">address_map = #{addressMap},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
          and (tenant_id = #{params.tenantId}<if test="params.tenantId != null and params.tenantId.equals(params.defaultTenantId)"> or tenant_id is null or tenant_id = ''</if>)
    </update>

    <delete id="deleteRtspDeviceById">
        delete from rtsp_device where id = #{id}
          and (tenant_id = #{tenantId}<if test="tenantId != null and tenantId.equals(defaultTenantId)"> or tenant_id is null or tenant_id = ''</if>)
    </delete>

    <delete id="deleteRtspDeviceByIds">
        delete from rtsp_device where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
          and (tenant_id = #{tenantId}<if test="tenantId != null and tenantId.equals(defaultTenantId)"> or tenant_id is null or tenant_id = ''</if>)
    </delete>
    <sql id="classificationFilter">
        <if test="categoryType != null and categoryType != ''">
            <choose>
                <when test="unclassified != null and unclassified">
                    and not exists (select 1 from wvp_device_category_relation cr where cr.protocol_type='RTSP'
                        and cr.device_key=cast(r.id as char) and cr.category_type=#{categoryType})
                </when>
                <when test="categoryId != null">
                    and exists (select 1 from wvp_device_category_relation cr
                        inner join wvp_device_category cc on cc.id=cr.category_id where cr.protocol_type='RTSP'
                        and cr.device_key=cast(r.id as char) and cr.category_type=#{categoryType}
                        and (cc.id=#{categoryId} or find_in_set(#{categoryId}, cc.ancestors)))
                </when>
            </choose>
        </if>
    </sql>
</mapper>
