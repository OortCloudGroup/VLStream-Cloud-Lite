<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.custom.mapper.CustomDeviceStateMapper">
    <resultMap id="Heartbeat" type="com.ruoyi.custom.domain.CustomTargetHeartbeat">
        <result property="online" column="online"/>
        <result property="onlineReason" column="online_reason"/>
        <result property="lastHeartbeatTime" column="last_heartbeat_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <select id="selectCameraTarget" resultMap="Heartbeat">
        select online, online_reason, last_heartbeat_time, update_time
        from wvp_vlstream_device
        where device_id=#{deviceId}
          and (tenant_id=#{tenantId} or (tenant_id is null and #{tenantId}=#{defaultTenantId}))
    </select>
</mapper>
